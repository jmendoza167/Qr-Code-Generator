{
  "name": "@jmendoza167/qrgen",
  "version": "0.2.0",
  "description": "QR code generator with the encoder written from scratch (ISO/IEC 18004). Terminal, SVG and PNG output. Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "jmendoza167",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmendoza167/Qr-Code-Generator.git"
  },
  "homepage": "https://github.com/jmendoza167/Qr-Code-Generator#readme",
  "bugs": {
    "url": "https://github.com/jmendoza167/Qr-Code-Generator/issues"
  },
  "keywords": [
    "qr",
    "qrcode",
    "qr-code",
    "generator",
    "cli",
    "terminal",
    "svg",
    "png",
    "reed-solomon"
  ],
  "bin": {
    "qrgen": "bin/qrgen.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core/qr.js",
    "./decode": "./src/decode/index.js",
    "./inspect": "./src/inspect/index.js",
    "./render/terminal": "./src/render/terminal.js",
    "./render/svg": "./src/render/svg.js",
    "./render/png": "./src/render/png.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "coverage": "c8 --reporter=text-summary --reporter=html --reports-dir=coverage npm test",
    "demo": "vhs docs/demo.tape"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
